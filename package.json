{
	"name": "effective-indexer",
	"version": "0.2.5",
	"author": {
		"name": "Aleksandr Shenshin",
		"email": "shenshin@me.com"
	},
	"contributors": [
		{
			"name": "Alexander Ivchenko (@TravellerOnTheRun)",
			"url": "https://github.com/TravellerOnTheRun"
		}
	],
	"description": "Lightweight EVM smart contract event indexer built with Effect",
	"repository": {
		"type": "git",
		"url": "https://github.com/cybervoid0/effective-indexer.git"
	},
	"homepage": "https://github.com/cybervoid0/effective-indexer#readme",
	"bugs": {
		"url": "https://github.com/cybervoid0/effective-indexer/issues"
	},
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"test": "vitest run",
		"test:integration": "RUN_EVM_INTEGRATION=true vitest run test/integration/evm.integration.test.ts",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"peerDependencies": {
		"effect": "^3.19.16"
	},
	"keywords": [
		"evm",
		"ethereum",
		"blockchain",
		"indexer",
		"events",
		"effect",
		"typescript",
		"rootstock",
		"rsk"
	],
	"dependencies": {
		"@effect/platform": "^0.94.4",
		"@effect/platform-node": "^0.104.1",
		"@effect/sql": "^0.49.0",
		"@effect/sql-sqlite-node": "^0.50.1",
		"log-update": "^6.1.0",
		"picocolors": "^1.1.1",
		"viem": "^2.45.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@effect/vitest": "^0.27.0",
		"@types/better-sqlite3": "^7.6.13",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
