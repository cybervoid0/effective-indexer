{
	"name": "@rootstock/indexer",
	"version": "0.1.0",
	"author": {
		"name": "Aleksandr Shenshin",
		"email": "mail@cybervoid.my"
	},
	"description": "Lightweight smart contract event indexer for Rootstock (RSK) blockchain",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"test": "vitest run",
		"test:integration": "RUN_RSK_INTEGRATION=true vitest run test/integration/rsk.integration.test.ts",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"peerDependencies": {
		"effect": "^3.19.16"
	},
	"keywords": [
		"rootstock",
		"rsk",
		"blockchain",
		"indexer",
		"events",
		"effect",
		"typescript"
	],
	"dependencies": {
		"@effect/platform": "^0.94.4",
		"@effect/platform-node": "^0.104.1",
		"@effect/sql": "^0.49.0",
		"@effect/sql-sqlite-node": "^0.50.1",
		"viem": "^2.45.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@effect/vitest": "^0.27.0",
		"@types/better-sqlite3": "^7.6.13",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
